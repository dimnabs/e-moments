# Database and object storage are started by docker compose for local development.
DATABASE_URL="postgresql://emoment:emoment_dev_password@localhost:5432/emoment"
S3_ENDPOINT="http://localhost:9000"
# Set this when the app reaches MinIO internally but browsers need a public URL
# for signed downloads (for example, https://storage.example.com).
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="e-moment"
S3_ACCESS_KEY="emoment"
S3_SECRET_KEY="emoment_dev_secret"
S3_REGION="us-east-1"
# MinIO defaults to path-style URLs. Set false only for an S3 provider that needs virtual-hosted URLs.
S3_FORCE_PATH_STYLE="true"
